# Where the landing reads the server-wide totals (GET /infinity/v1/stats, CORS open).
VITE_STATS_URL=http://localhost:8081/infinity/v1/stats
# The server players connect to (shown in the install steps; empty = "ask whoever runs it").
VITE_SERVER_ADDRESS=
# The repository (download links point at its latest release).
VITE_REPO=anarqz/ForzaInfinity
